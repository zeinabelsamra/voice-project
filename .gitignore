# Environment variables — never commit these
node-backend/.env
.env

# Admin-editable DB credentials saved from the Settings page — never commit
node-backend/config/

# Real hospital eDelphyn schema export — internal hospital IP, kept local
# only as a reference for validating node-backend/edelphyn-test-db scripts
# and edelphynQueries.js/edelphynAnalyticsQueries.js against the real schema
node-backend/edelphyn-test-db/schema.sql

# Dependencies
node-backend/node_modules/
python-service/venv/
rag-chatbot/venv/
rag-chatbot/__pycache__/

# Regenerable build artifacts (rebuild with refresh_data.py) -- not source,
# and data_snapshot/ is a live pull from e-Delphyn so shouldn't be
# committed on principle even though this test data happens to be synthetic
rag-chatbot/chroma_db/
rag-chatbot/data_snapshot/

# Uploaded audio files
node-backend/uploads/

# Runtime logs
node-backend/*.log

# OS files
.DS_Store
Thumbs.db
